######################################################################
# Unreal Engine 项目 .gitignore
# 适用于 UE4 / UE5（蓝图 & C++ 项目）
######################################################################

############################
# IDE / 工具相关
############################

# Visual Studio
.vs/
.vsconfig
*.suo
*.user
*.userosscache
*.sln.docstates
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj.user
*.vcxproj.user.*
*.vcxproj.filters

# Rider / CLion / IntelliJ
.idea/
.rider/
*.iml

# VS Code
.vscode/

# 其他编辑器
*.sublime-project
*.sublime-workspace


############################
# Unreal 引擎目录与编译产物
############################

# 二进制输出
Binaries/
Plugins/**/Binaries/

# 中间文件
Intermediate/
Plugins/**/Intermediate/

# Saved 中主要是运行时生成数据、日志、自动备份等
Saved/
Plugins/**/Saved/

# 构建目标与打包中间文件
Build/

# 派生数据缓存（可重建）
DerivedDataCache/

# C/C++ 编译产物
*.slo
*.lo
*.o
*.obj
*.tlog

# 预编译头
*.gch
*.pch

# 库文件
*.lib
*.a
*.la
*.lai
*.exp

# 可执行文件 / 安装包
*.exe
*.out
*.app
*.ipa
*.apk
*.msi
*.msix
*.dmg
*.pkg


############################
# 配置文件（保留默认配置）
############################

# 一般建议：
# - 忽略所有运行时 / 用户特定 ini
# - 只提交 Default*.ini 作为团队统一配置基线

Config/*.ini
!Config/Default*.ini


############################
# 日志 & 临时文件
############################

# UE 运行日志
*.log

# 常见临时文件
*.tmp
*.temp
*.cache
*.bak
*.backup
*.swp
*.swo

# 编译 / 调试相关
*.pdb
*.ipch
*.idb
*.ilk


############################
# 资源与大文件（建议配合 Git LFS）
############################

# 注意：下面这些类型通常体积大，推荐在 .gitattributes 里用 Git LFS 跟踪
# 这里不忽略它们，因为它们通常是项目必须的内容资源

# Unreal 资产
# （如果你希望只允许特定资源类型，可视团队策略进一步细化）
# *.uasset
# *.umap

# 常见图片资源
# *.png
# *.jpg
# *.jpeg
# *.tga
# *.bmp
# *.exr
# *.hdr

# 音频资源
# *.wav
# *.ogg
# *.mp3
# *.flac

# 模型资源
# *.fbx
# *.obj
# *.glb
# *.gltf
# *.blend

# 关卡构建数据（一般会随地图一起提交，这里不忽略）
# *_BuiltData.uasset


############################
# 操作系统杂项
############################

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon?
._*

# Linux / Unix
*~
.directory


############################
# 其他常见忽略项
############################

# 压缩包 / 临时打包输出（视团队需要，可酌情提交）
*.zip
*.7z
*.rar
*.tar
*.gz

# 代码分析、覆盖率等
*.codecov
*.lcov
*.gcda
*.gcno

# Node / Python（如果项目中用到）
node_modules/
__pycache__/
*.pyc